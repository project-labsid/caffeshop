generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

// ===================== ACCOUNT (Multi-Tenancy) =====================

model Account {
  id          String    @id @default(cuid())
  name        String    // e.g. "Kopi Shop A", "Kopi Shop B"
  slug        String    @unique  // URL-friendly identifier
  ownerEmail  String    // Email of the account creator
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users              User[]
  branches           Branch[]
  categories         Category[]

  products           Product[]
  transactions       Transaction[]
  purchases          Purchase[]
  stockAdjustments   StockAdjustment[]
  storeSettings      StoreSetting[]
  taxSettings        TaxSetting[]
  serviceChargeSettings ServiceChargeSetting[]
  activityLogs       ActivityLog[]
  paymentMethods     PaymentMethod[]
  subscriptionPlans  SubscriptionPlan[]
  subscriptions      Subscription[]
  aiUsages           AiUsage[]
  aiChatLogs         AiChatLog[]
  aiProviderConfigs  AiProviderConfig[]
}

// ===================== USER & AUTH =====================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  password      String
  phone         String?
  avatar        String?
  role          String    @default("cashier") // super_admin, admin, cashier
  branchId      String?
  accountId     String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([email, accountId])  // Email unique per account, not globally

  account         Account   @relation(fields: [accountId], references: [id])
  branch          Branch?   @relation(fields: [branchId], references: [id])
  transactions    Transaction[]
  activityLogs    ActivityLog[]
  purchases       Purchase[]
  stockAdjustments StockAdjustment[]
  subscriptions  Subscription[]
  aiUsages        AiUsage[]
  aiChatLogs      AiChatLog[]
}

// ===================== BRANCH =====================

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account          Account  @relation(fields: [accountId], references: [id])
  users            User[]
  products         Product[]
  transactions     Transaction[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
}

// ===================== CATEGORY =====================

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account    @relation(fields: [accountId], references: [id])
  products    Product[]
  taxSettings TaxSetting[]
}



// ===================== PRODUCT =====================

model Product {
  id            String   @id @default(cuid())
  name          String
  categoryId    String?
  costPrice     Float    @default(0)
  sellPrice     Float    @default(0)
  stock         Int      @default(0)
  minStock      Int      @default(5)
  image         String?
  isActive      Boolean  @default(true)
  branchId      String?
  accountId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account           Account            @relation(fields: [accountId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  transactionItems  TransactionItem[]
  purchaseItems     PurchaseItem[]
  stockAdjustments  StockAdjustment[]
}

// ===================== TRANSACTION =====================

model Transaction {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  userId          String
  customerName    String?
  branchId        String?
  type            String   @default("sale") // sale, refund
  status          String   @default("completed") // pending, completed, cancelled, held
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  serviceCharge   Float    @default(0)
  grandTotal      Float    @default(0)
  paidAmount      Float    @default(0)
  changeAmount    Float    @default(0)
  paymentMethod   String   @default("cash")
  paymentDetails  String?  // JSON string for multi-payment
  notes           String?
  accountId       String
  heldAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account        Account    @relation(fields: [accountId], references: [id])
  user           User       @relation(fields: [userId], references: [id])
  branch         Branch?    @relation(fields: [branchId], references: [id])
  items          TransactionItem[]
}

// ===================== TRANSACTION ITEM =====================

model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  quantity      Int
  price         Float
  costPrice     Float    @default(0)
  discount      Float    @default(0)
  total         Float
  notes         String?
  createdAt     DateTime @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])
}

// ===================== PURCHASE =====================

model Purchase {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  userId        String
  branchId      String?
  totalAmount   Float    @default(0)
  status        String   @default("received") // pending, received, cancelled
  notes         String?
  accountId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       Account   @relation(fields: [accountId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  branch        Branch?   @relation(fields: [branchId], references: [id])
  items         PurchaseItem[]
}

// ===================== PURCHASE ITEM =====================

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  quantity    Int
  costPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

// ===================== STOCK ADJUSTMENT =====================

model StockAdjustment {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  branchId      String?
  type          String   // in, out, adjustment, opname
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  accountId     String
  createdAt     DateTime @default(now())

  account      Account  @relation(fields: [accountId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
}

// ===================== STORE SETTINGS =====================

model StoreSetting {
  id          String   @id @default(cuid())
  key         String
  value       String
  description String?
  accountId   String
  updatedAt   DateTime @updatedAt

  @@unique([key, accountId])

  account     Account  @relation(fields: [accountId], references: [id])
}

// ===================== TAX SETTING =====================

model TaxSetting {
  id            String   @id @default(cuid())
  isEnabled     Boolean  @default(false)
  percentage    Float    @default(11)
  mode          String   @default("exclude") // include, exclude
  applyToAll    Boolean  @default(true)
  categoryId    String?
  accountId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       Account   @relation(fields: [accountId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
}

// ===================== SERVICE CHARGE SETTING =====================

model ServiceChargeSetting {
  id          String   @id @default(cuid())
  isEnabled   Boolean  @default(false)
  percentage  Float    @default(5)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account  @relation(fields: [accountId], references: [id])
}

// ===================== ACTIVITY LOG =====================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  details   String?  // JSON
  ipAddress String?
  accountId String
  createdAt DateTime @default(now())

  account   Account  @relation(fields: [accountId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

// ===================== SUBSCRIPTION PLANS =====================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String              // Gratis, Pro, Enterprise
  price         Float    @default(0)
  period        String   @default("monthly") // monthly, yearly
  maxProducts   Int      @default(200)
  maxBranches   Int      @default(1)
  maxUsers      Int      @default(2)
  maxStorage    Int      @default(500)  // MB
  aiChatDaily   Int      @default(10)
  aiChatMonthly Int      @default(300)
  features      String              // JSON array of feature strings
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  accountId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account        Account        @relation(fields: [accountId], references: [id])
  subscriptions Subscription[]
}

// ===================== SUBSCRIPTIONS =====================

model Subscription {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  status          String           @default("active") // active, cancelled, expired
  startDate       DateTime         @default(now())
  endDate         DateTime?
  accountId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  account         Account           @relation(fields: [accountId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
  usages          SubscriptionUsage[]
}

// ===================== SUBSCRIPTION USAGE =====================

model SubscriptionUsage {
  id             String   @id @default(cuid())
  subscriptionId String
  metric         String               // products, branches, users, storage, ai_daily, ai_monthly
  currentValue   Int      @default(0)
  maxValue       Int      @default(0)
  resetAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ===================== PAYMENT METHODS =====================

model PaymentMethod {
  id              String   @id @default(cuid())
  name            String
  type            String               // cash, qris, transfer, virtual_account, ewallet, debit, credit, manual, other
  description     String?
  status          String   @default("active") // active, inactive
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  icon            String?
  logo            String?
  bankName        String?
  accountNumber   String?
  accountHolder   String?
  branch          String?
  swiftCode       String?
  phone           String?
  provider        String?              // gojek, ovo, dana, shopeepay, linkaja
  merchantId      String?
  merchantName    String?
  qrImage         String?
  instructions    String?
  paymentGateway  String?              // stripe, midtrans, xendit
  cardProvider    String?              // visa, mastercard, jcb, amex
  accountId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  account         Account  @relation(fields: [accountId], references: [id])
}

// ===================== AI USAGE =====================

model AiUsage {
  id            String   @id @default(cuid())
  userId        String
  type          String               // chat, summary, analysis, prediction, restock, insight
  tokensUsed    Int      @default(0)
  modelUsed     String?
  provider      String?
  cost          Float    @default(0)
  accountId     String
  createdAt     DateTime @default(now())

  account       Account  @relation(fields: [accountId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

// ===================== AI CHAT LOGS =====================

model AiChatLog {
  id            String   @id @default(cuid())
  userId        String
  role          String               // user, assistant
  content       String
  tokensUsed    Int      @default(0)
  modelUsed     String?
  accountId     String
  createdAt     DateTime @default(now())

  account       Account  @relation(fields: [accountId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

// ===================== AI PROVIDER CONFIG (Super Admin) =====================

model AiProviderConfig {
  id            String   @id @default(cuid())
  provider      String               // openai, anthropic, gemini, deepseek, openrouter
  apiKey        String
  modelDefault  String
  modelFallback String?
  maxTokens     Int      @default(4096)
  isActive      Boolean  @default(true)
  accountId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       Account  @relation(fields: [accountId], references: [id])
}
